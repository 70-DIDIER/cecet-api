APP_NAME="CECT API"
APP_VERSION=dev
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cectapi
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# E-mail : envoie les codes OTP et les notifications.
# "log" (dev) : les messages sont écrits dans storage/logs/laravel.log, rien n'est envoyé.
# En recette/production : MAIL_MAILER=smtp avec les identifiants du fournisseur ; exemple :
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.exemple.com  MAIL_PORT=587  MAIL_SCHEME=null (STARTTLS)
#   MAIL_USERNAME=...  MAIL_PASSWORD=...  MAIL_FROM_ADDRESS="no-reply@cect.example"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:5174,127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
SESSION_SECURE_COOKIE=false
# Page du site où le prestataire ramène le membre après un paiement hébergé.
PAYMENT_RETURN_URL=http://localhost:3000/adhesion/retour
# FedaPay : "sandbox" pour les essais, "live" en production. Clés dans le tableau de bord FedaPay.
# FEDAPAY_WEBHOOK_SECRET : secret du webhook déclaré vers POST {APP_URL}/api/v1/webhooks/payments/fedapay
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=

# --- Données de démonstration (développement / recette uniquement) ---
DEMO_CLIENT_EMAIL=tandemodon55@gmail.com
DEMO_MERCHANT_EMAIL=marchand.demo@cect.example
DEMO_STAFF_EMAIL=superadmin.demo@cect.example
DEMO_PASSWORD=Demo2026cect

